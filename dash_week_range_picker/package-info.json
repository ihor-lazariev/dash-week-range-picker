{
    "name": "dash_week_range_picker",
    "version": "0.2.0",
    "description": "Mantine-based ISO-week range picker for Dash",
    "main": "build/index.js",
    "scripts": {
        "start": "webpack serve --config ./webpack.serve.config.js --open",
        "validate-init": "python _validate_init.py",
        "prepublishOnly": "npm run validate-init",
        "build:js": "webpack --mode production",
        "build:backends": "dash-generate-components ./src/lib/components dash_week_range_picker -p package-info.json --ignore \\.test\\.",
        "build:backends-activated": "(. venv/bin/activate || venv\\scripts\\activate && npm run build:backends)",
        "build": "npm run build:js && npm run build:backends",
        "build:activated": "npm run build:js && npm run build:backends-activated",
        "watch": "webpack --mode production --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix"
    },
    "author": "Ihor Lazariev <121246456+ihor-lazariev@users.noreply.github.com>",
    "license": "MIT",
    "dependencies": {
        "@mantine/core": "8.3.18",
        "@mantine/dates": "8.3.18",
        "@mantine/hooks": "8.3.18",
        "dayjs": "^1.11.13"
    },
    "peerDependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@babel/core": "^7.22.1",
        "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
        "@babel/preset-env": "^7.22.2",
        "@babel/preset-react": "^7.22.3",
        "@plotly/dash-component-plugins": "^1.2.3",
        "@plotly/webpack-dash-dynamic-import": "^1.2.0",
        "@testing-library/react": "^16.0.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "babel-eslint": "^10.1.0",
        "babel-loader": "^9.1.2",
        "copyfiles": "^2.1.1",
        "css-loader": "^6.8.1",
        "eslint": "^6.0.1",
        "eslint-config-prettier": "^6.0.0",
        "eslint-plugin-import": "^2.18.0",
        "eslint-plugin-react": "^7.14.2",
        "eslint-plugin-react-hooks": "^4.6.2",
        "jsdom": "^25.0.0",
        "prettier": "^3.3.0",
        "prop-types": "^15.8.1",
        "react": "^18.2.0",
        "react-docgen": "^5.4.3",
        "react-dom": "^18.2.0",
        "style-loader": "^3.3.3",
        "ts-loader": "^9.5.1",
        "typescript": "^5.6.3",
        "vitest": "^2.1.0",
        "webpack": "^5.84.1",
        "webpack-cli": "^5.1.1",
        "webpack-dev-server": "^4.15.0"
    },
    "engines": {
        "node": ">=8.11.0",
        "npm": ">=6.1.0"
    }
}
