# Project code-style baseline. IDEs (PyCharm/IntelliJ, VS Code, etc.) honor this and it overrides their
# own defaults - notably PyCharm's 2-space JSON default, which was fighting the project's 4-space standard
# (Prettier tabWidth 4, Black 4-space). Keep this in sync with .prettierrc / pyproject.toml.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Makefiles require real tabs
[Makefile]
indent_style = tab

# Markdown: trailing spaces are a hard line break, don't strip them
[*.md]
trim_trailing_whitespace = false

# npm owns this file and always rewrites it with 2-space indent; keep it so the IDE never reindents it
[package-lock.json]
indent_size = 2
