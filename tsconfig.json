{
    "compilerOptions": {
        "jsx": "react",
        "target": "es2019",
        "module": "esnext",
        "moduleResolution": "node",
        "lib": ["dom", "dom.iterable", "es2020"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "inlineSources": true
    },
    "include": ["src/lib"],
    "exclude": ["node_modules"]
}
